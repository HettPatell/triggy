{
  "version": 2,
  "cleanUrls": false,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/api/auth", "destination": "/api/auth.php" },
    { "source": "/api/restaurants", "destination": "/api/restaurants.php" },
    { "source": "/api/orders", "destination": "/api/orders.php" },
    { "source": "/api/favorites", "destination": "/api/favorites.php" },
    { "source": "/api/search", "destination": "/api/search.php" },
    { "source": "/api/admin", "destination": "/api/admin.php" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
